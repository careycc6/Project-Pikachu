{
  "name": "Pokemon Showdown Gen9",
  "id": "pokemon-showdown-gen9",
  "description": "AI agent plays Gen 9 Random Battles on Pokemon Showdown",
  "adapter": "adapter.py",
  "binding_vow": {
    "version": "1.0.0",
    "tier": "tier1",
    "observation_space": {
      "type": "json",
      "description": "Current battle state including active Pokemon, HP, available moves and switches, and opponent info"
    },
    "action_space": {
      "type": "discrete",
      "enum_values": ["1", "2", "3", "4", "switch:1", "switch:2", "switch:3", "switch:4", "switch:5"]
    },
    "reward": {
      "type": "binary",
      "range": {"low": 0.0, "high": 1.0},
      "description": "1.0 for winning the battle, 0.0 for losing"
    },
    "episode": {
      "max_steps": 200,
      "supports_seed": true,
      "parallel_episodes": 1,
      "observability": "partial"
    }
  },
  "scoring": {
    "primary_metric": "win_rate",
    "higher_is_better": true,
    "metrics": [
      {
        "name": "win_rate",
        "type": "episode_reward",
        "aggregation": "pass_rate",
        "pass_threshold": 0.5
      }
    ]
  }
}
